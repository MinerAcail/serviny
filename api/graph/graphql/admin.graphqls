type Admin {
  id: String!
  name: String!
  type: String!
  number: String!
  password: String
  createdAt: Time!
  updatedAt: Time!
}


type GrowthData {
  totalOrders: String!
  currentOrders: String!
  percentage: String!
}

extend type Query {
  getAllSession: [Session]
  getAdmin(id: String!): Admin
  getGrowthData(id: String!): GrowthData
  listAdmins: [Admin!]!
  # reviewApplicate: [RiderRequest]
  # reviewAllWorks: [RiderRequest]
  # getAllWorks: [RiderRequest]
}

extend type Mutation {
  createAdmin(input: CreateAdminInput!): Admin
  updateAdminStatus(id: String!, status: String!): Admin
  updateAdmin(id: String!, input: UpdateAdminInput!): Admin
  deleteAdmin(id: String!): Boolean
  # RiderRequest(input: RiderRequestInput): RiderRequest
  # useGetRiderRequestTracking: RiderRequest

  # jobResponse(applicantId: String!, State: String!): RiderRequest
  # worksUpdate(applicantId: String!, input: worksInput): RiderRequest
}

input CreateAdminInput {
  name: String!
  type: String!
  number: String!
  password: String
  status: String
}

input UpdateAdminInput {
  name: String
  type: String
  number: String
  password: String
}
input worksInput {
  name: String
  email: String
  type: String
  number: String
  state: String
  password: String
  experience: String
}

type Session {
  id: String!
  userId: String
  ipAddress: String!
  userAgent: String!
  createdAt: Time
  updatedAt: Time
}


enum UserType {
  SERVICE
  ADMIN
  USER
  DELIVERY
}