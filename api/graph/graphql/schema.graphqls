scalar Time
scalar Upload

type UserBookings {
  id: String!
  bookTypeId: String!
  bookType: String!
  serviceId: String!
  userId: String!
  tableSize: Int
  notes: String
  isBooked: Boolean!
  createdAt: Time!
  updatedAt: Time!
}

type SystemInfo {
  bdTable: String!
  dbName: String!
}

type EventBookedData {
  userId: String!
  userName: String!
  userNumber: String!
  bookTypeId: String!
  bookTypeImageUrl: String!
  bookTypeName: String!
  bookType: String!
  bookTypePrice: String!
  booked: UserBookings!
}
type ProfileInfor {
  id: String
  businessType: String
}
extend type Query {
  getID: String
  # who: Returns
  getAllSystemInfo: SystemInfo!

  # Get user's bookingss
  getAUserBookings(userId: String!): [UserBookings!]!

  getUserBookings(
    bookTypeId: String!
    # bookType: String!
    userId: String!
  ): UserBookings!

  getUserInfor(userId: String!): UsersInfor
  getUserInforFromContext: UsersInfor
  getUserInforFromContextForAuthClient: UsersInfor

  clearClientCache: Boolean!

  cheakType(serviceId: String!): String!
  getProfiles: Profiles
  getAProfileIdByUserId(userId: String): String
  getAProfileBusinessTypeByUserId: ProfileInfor!

  # payment status
  getBookingOrderPaymentStatus(
    entityId: String!
    entityType: String!
    statusType: String!
  ): String
  getBookingOrderPaymentStatusByUser(
    entityId: String!
    entityType: String!
  ): BookingOrderPaymentStatus

  getstau:[BookingOrderPaymentStatus]
}
type UsersInfor {
  id: String!
  name: String!
  type: String!
  number: String!
  email: String!
  location: String
  coordinates: [Float]

  dpfile: String
}
extend type Mutation {
  deleteTable: Boolean!
  serviceLogin(input: LoginInput!): Returns
  adminLogin(input: LoginInput!): Admin
  # workersLogin(input: LoginInput!): jobRequest
  deliveryLogin(input: LoginInput): Returns
  logOut: Boolean!

  UserBookings(
    bookTypeID: String!
    userId: String
    tableSize: Int
    notes: String
    bookType: String
  ): UserBookings!
  cancelUserBookings(
    bookTypeId: String!
    # bookType: String!
    userId: String!
  ): Boolean!

  profiles(profileId: String!, removeProfileId: String): Profiles

  ## payment status

  ## for creating and updating booking order payment status
  updateBookingOrderPaymentStatus(
    id: String!
    serviceId: String
    userId: String
    riderId: String
    status: String!
    entityId: String!
    entityType: String!
    statusType: String!
  ): String!
  orderOrBookingPayment(
    entityId: String!
    entityType: String!
    method: String!
    reference: String!
  ): BookingOrderPaymentStatus!

  updateOrderBookStatus(
      entityId: String!
    entityType: String!
    status: String!

  ):String
  # deleteBookingOrderPaymentStatus(id: String!): Boolean
}
type Profiles {
  id: String!
  type: String!
  profileIds: [String]
  userId: String!
  createdAt: Time!
  updatedAt: Time!
}
input LoginInput {
  password: String!
  number: String
}

type PurchaseHistoryItem {
  id: String!
  name: String!
  price: String!
  quantity: String!
  imageUrl: String!
}

type PurchaseHistory {
  id: String!
  date: String!
  items: [PurchaseHistoryItem!]!
  status: String!
  trackingNumber: String
}

union Returns = User | Service | Admin | Rider

type BookingOrderPaymentStatus {
  id: String!
  serviceId: String
  userId: String
  riderId: String
  status: String!
  method: String!
  entityId: String!
  entityType: String!
  reference: String
  createdAt: Time!
  updatedAt: Time!
}


