type Service {
  id: String!
  name: String!
  type: String!
  number: String!
  email: String!
  profession: [String]
  categories: [String]
  businessType: String
  businessTypeId: String
  location: String
  aboutMe: String
  password: String
  dpfile: String
  useTheme: String
  bookTypes: [String]
  state: String
  isVerified: Boolean
  isAuth: isAuth
  numberType: String
  subDomain: String
  coordinates: [Float]
  h3Indexes: [String]
  createdAt: Time!
  updatedAt: Time!
}
enum isAuth {
  padding
  authenticated
  unauthenticated
}
enum BookingType {
  APPOINTMENT
  RENTAL
  EVENT
  ON_DEMAND
  PACKAGE
  CUSTOM_QUOTE
}
type Rating {
  id: String
  ServiceId: String
  reviewCount: Int
  rating: Int
  createdAt: Time!
  updatedAt: Time!
}
input GalleryProfessionInput {
  title: String
  description: String
  categories: [String]
  imageUrls: [String]
}
type GalleryProfession {
  id: String
  title: String
  ServiceId: String
  categories: [String]
  imageUrls: [String]
  description: String
  createdAt: Time!
  updatedAt: Time!
}

extend type Query {
  listServices(search: String, limit: Int, offset: Int): [Service!]!
  getService: Service
  getProvider(ServiceId: String): Service
  getProviderByUsername(subDomain: String!): Service
  getUseTheme(ServiceId: String!): String

  getSharedService(ServiceId: String!): Service
  getAllGallery(
    ServiceId: String!
    query: String
    limit: Int
    offset: Int
  ): [GalleryProfession]
  getGallery(galleryID: String!): GalleryProfession
  getAllCategoriesFromGallery(ServiceId: String!): [String]
  getAllProfessionFromService: [String]
  getBookingType(serviceId: String!): [BookingType!]!
  getDashboardData: DashboardData
  getFavorites: [Favorite!]!
  getProvidersUsersContact(
    search: String
    limit: Int = 10
    offset: Int = 0
  ): [UserData!]!

  getSocialMedia(serviceId: String!): SocialMedia

  getAllRidersServiceData: [ServiceData!]!
  getBookingServiceData: [ServiceData!]!
  getOrderServiceData: [ServiceData!]!

  getAllUserServiceData: [ServiceData!]!
  getBookingServiceDataByUserId: [ServiceData!]!
  getBookingServiceDataByBookingId(bookingId: String!): AppointmentBookingData!
  getOrderServiceDataByUserId: [ServiceData!]!

  getBusinessType:BusinessType

}

extend type Mutation {
  createService(dpfile: Upload, input: CreateServiceInput!): Service
  updateService(
    dpfile: Upload
    input: UpdateServiceInput!
    removeProfession: [String]
  ): Service
  updateBusinessType(businessType:String):BusinessType
  generateSubDomain(serviceId: String!): Service
  useTheme(ServiceId: String!, theme: String): String

  deleteService(id: String!): Boolean

  updateBookingType(
    type: BookingType! # serviceId: String!
  ): BookingType
  createGallery(
    files: [Upload]
    input: GalleryProfessionInput!
  ): GalleryProfession!
  updateGallery(
    galleryID: String!
    files: [Upload]
    input: GalleryProfessionInput!
    removeUrl: [String]
  ): GalleryProfession!
  deleteGallery(id: String!): Boolean
  createFavorite(input: CreateFavoriteInput): Favorite
  createSocialMedia(input: SocialMediaInput): SocialMedia

  reAssignRider(
    entityId: String
    entityType: String
    riderId: String
  ): UsersInfor
}

input CreateServiceInput {
  name: String!
  number: String!
  email: String!
  location: String
  profession: [String]
  categories: [String]
  coordinates: [Float]

  businessType: String
  password: String
}
input UpdateServiceInput {
  name: String
  type: String
  number: String
  email: String
  profession: [String]
  aboutMe: String
  location: String

  password: String
}

type DashboardData {
  totalUsers: [String!]!
  totalBookingsIds: [String!]!
  favoritesIds: [String!]!
  recentActivityIds: [String!]!
  categoriesServiceTypes: [BookingType!]!
}

input CreateFavoriteInput {
  address: String
  otherNumber: [String]
  Note: String
  userId: String!
}
type Favorite {
  id: String!
  userId: String!
  serviceId: String!
  address: String
  otherNumber: [String]
  Note: String
  createdAt: Time!
  updatedAt: Time!
}

type SocialMedia {
  id: String!
  ServiceId: String!
  socialData: String
  createdAt: Time!
  updatedAt: Time!
}

input SocialMediaInput {
  name: String!
  icon: String!
  link: String!
}

type ServiceData {
  id: String!
  serviceId: String!
  type: ServiceType! # "ORDER" or "BOOKING"
  rider: UsersInfor
  customer: UsersInfor!
  vendor: Service!
  createdAt: Time!

  # Union-like approach - only one will be populated based on type
  orderData: CartItemOrder
  bookingData: AppointmentBookingData
}
type AppointmentBookingData {
  bookingId: String!
  startTime: String!
  endTime: String!
  day: String!
  notes: String
  item: String
  tableSize: Int!
  userType: String!
  isConfirmed: Boolean
  # Booking-specific location data
  pickupLocation: [Float!]
  dropoffLocation: [Float!]
  deliveryAddress: String!
  pickUpAddress: String
  multiGroupId: String
  status: String
  paymentStatus: String
  paymentMethod: String
  transportType: String
  cargoId: String
  # Booking-specific pricing/route metadata
  deliveryFee: String
  distance: String
  duration: String
  estimatedDeliveryDate: String
  routeData: RouteInfo
  rangeMetaData: RiderRange # Booking uses RangeMetaData instead of ZoneMetaData
}

enum ServiceType {
  ORDER
  BOOKING
}

type BusinessType {
  id: String!
  status: String
  serviceId:String!
  paymentStatus: String
  paymentMethod: String
  businessType: String
  durationAt: String
  durationEnd: String
  createdAt: Time!
  updatedAt: Time!
}
