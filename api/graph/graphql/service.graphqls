type Service {
  id: String!
  name: String!
  type: String!
  number: String!
  email: String!
  profession: [String]
  location: String
  aboutMe: String
  password: String
  dpfile: String
  bookTypes: [String]
  isAuth: isAuth
  numberType: String
  createdAt: Time!
  updatedAt: Time!
}
enum isAuth {
  padding
  authenticated
  unauthenticated
}
enum BookingType {
  APPOINTMENT
  RENTAL
  EVENT
  ON_DEMAND
  PACKAGE
  CUSTOM_QUOTE
}
type Rating {
  id: String
  ServiceId: String
  reviewCount: Int
  rating: Int
  createdAt: Time!
  updatedAt: Time!
}
input GalleryProfessionInput {
  title: String
  description: String
  categories: [String]
  imageUrls: [String]
}
type GalleryProfession {
  id: String
  title: String
  ServiceId: String
  categories: [String]
  imageUrls: [String]
  description: String
  createdAt: Time!
  updatedAt: Time!
}

extend type Query {
  getService: Service
  getProvider(ServiceId: String!): Service
  getSharedService(ServiceId: String!): Service
  listServices(search: String, limit: Int, offset: Int): [Service!]!
  getAllGallery(ServiceId: String!): [GalleryProfession]
  getAllCategoriesFromGallery(ServiceId: String!): [String]
  getAllProfessionFromService: [String]
  getBookingType(
    serviceId: String!
  ): [BookingType!]!
  getDashboardData: DashboardData
  getFavorites: [Favorite!]!
  getProvidersUsersContact(
    search: String
    limit: Int = 10
    offset: Int = 0
  ): [UserData!]!
}

extend type Mutation {
  createService(dpfile: Upload, input: CreateServiceInput!): Service
  updateService(
    dpfile: Upload
    input: UpdateServiceInput!
    removeProfession: [String]
  ): Service
  deleteService(id: String!): Boolean

  updateBookingType(
    type: BookingType!
    # serviceId: String!
  ): BookingType
  createGallery(
    files: [Upload]
    input: GalleryProfessionInput!
  ): GalleryProfession!
  updateGallery(
    galleryID: String!
    files: [Upload]
    input: GalleryProfessionInput!
    removeUrl: [String]
  ): GalleryProfession!
  deleteGallery(id: String!): Boolean
  createFavorite(input:CreateFavoriteInput): Favorite
}

input CreateServiceInput {
  name: String!
  number: String!
  email: String!
  location: String
  profession: [String]
  password: String
}
input UpdateServiceInput {
  name: String
  type: String
  number: String
  email: String
  profession: [String]
  aboutMe: String
  location: String
  password: String
}


type DashboardData {
  totalUsers: [String!]!
  totalBookingsIds: [String!]!
  favoritesIds: [String!]!
  recentActivityIds: [String!]!
  categoriesServiceTypes: [BookingType!]!
}


input CreateFavoriteInput {
  address: String
  otherNumber: [String]
  Note: String
  userId: String!
}
type Favorite {
  id: String!
  userId: String!
  serviceId: String!
  address: String
  otherNumber: [String]
  Note: String
  createdAt: Time!
  updatedAt: Time!
}