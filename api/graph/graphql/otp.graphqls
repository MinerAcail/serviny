type OtpResponse {
  success: Boolean!
  message: String!
  otpSent: Boolean!
  IsValid: Boolean!
  entityId: String
  entityType: String
  messageType: String!
  email: String
}

enum ReasonType {
  RESET_PASSWORD
  CREATE_USER
  LOGIN
  TWO_FACTOR_AUTH
  ACCOUNT_RECOVERY
}

type ResetPasswordResponse {
  success: Boolean!
  message: String!
  isReset: Boolean!
  email: String
}

## Inputs

input ResetPasswordInput {
  number: String!
  otp: String!
  newPassword: String!
  confirmPassword: String!
  type: String!
}

input RequestOtpInput {
  email: String!
  number: String!
  name: String!
  type: String!
}

input VerifyOtpInput {
  number: String!
  otp: String!
  type: String!
}
input ResetPassWordOtpInput {
  number: String!
  # name: String!
}
extend type Query {
  getSms(number: String!,entityId:String): SmsRecord!
  getSmsHistory(number: String!, entityID: String, limit: Int): [SmsRecord!]!
}
extend type Mutation {
  requestOtp(input: RequestOtpInput!): OtpResponse!
  testRequestOtp(numbers: [String]): Boolean!
  requestForResetOtp(input: ResetPassWordOtpInput!): OtpResponse!
  verifyOtp(input: VerifyOtpInput!): OtpResponse
  resendOTP(input: RequestOtpInput!): OtpResponse
  reSetPasswordORUpdateOTP(input: RequestOtpInput!): OtpResponse

  # Reset password with OTP verification
  resetPassword(input: ResetPasswordInput!): ResetPasswordResponse!

  smsMessageBook(input: smsInput!): SmsRecord!
}
input smsInput {
  number: String!
  message: String!
  entityId:String
  entityType: String!
  userId: String
}
# SMS Record type for database storage
type SmsRecord {
  id: String!
  number: String!
  message: String!
  entityId: String
  entityType: String
  messageType: String!
  status: String!
  serviceId: String
  userId: String
  createdAt: Time!
  updatedAt: Time!
}