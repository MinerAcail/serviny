input IsochroneInput {
  locations: [[Float!]!]!
  range: [Int!]!
  transportMode: String
  vendorId: String!
  address: String
  metaData: [ZoneMetaDataInput]!
  riderRangeIds: [String]

}
input ZoneMetaDataInput {
   price: Float!
  distance: Float
  riderRangeId: String
  zoneNumber: Int
}
type IsochroneResult {
  id: String!
  geojson: String!
  metaData: [IsochroneZoneMetaData!]!
  locations: [[Float!]!]
  range: [Int!]!
  vendorId: String!
  transportMode: String
  address: String
  createdAt: String
  updatedAt: String
  status: String
  riderId: String
  error: String
  errorCode: String
  riderRangeIds: [String!]
  riderRanges: [RiderRange!]!
}

type IsochroneRiderRangeLink {
  id: String!
  isochroneId: String!
  riderRangeId: String!
  createdAt: Time!
  updatedAt: Time!
}

type IsochroneZoneMetaData {
  id: String!
  price: Float!
  duration: Int!
  distance: Float!
  zone: Int!
  riderRangeId: String
}
type ZoneMetaData {
  id: String!
  price: Float!
  duration: Int!
  distance: Float!
  zone: Int!
  geojson: String
  isochroneId: String!
}
type CacheStats {
  totalEntries: Int!
  entries: [CacheEntry!]!
}

type CacheEntry {
  key: String!
  ttl: Int!
}

input CacheManagementInput {
  action: String! # "purge", "refresh", "stats", "prewarm"
  locations: [[Float!]!] # For prewarm/refresh actions
  ranges: [Int!] # For prewarm/refresh actions
  transportModes: [String!] # For prewarm/refresh actions
  ttl: Int # For refresh action (seconds)
  Addresses: String
}

extend type Query {
  # Get isochrone result by UUID and location
  getIsochroneResult(location: [Float!]!, uuid: String!): IsochroneResult
  getAllIsochroneResults: [IsochroneResult!]
  getAllIsochroneRiderRangeLinkResults: [IsochroneRiderRangeLink!]
  # Get isochrone result by ID
  getIsochroneById(id: String!): IsochroneResult

  getRiderProfile(riderId: String!): RiderProfile

  getASingleIsochroneZoneMetaDataByMetaId(
    isochroneMetaId: String!
  ): ZoneMetaData
  # Get isochrones by rider ID
  getIsochronesByRider(riderId: String!): IsochroneResult!
  getAllIsochronesByRider(riderId: String!): [IsochroneResult!]
  getAllIsochronesByVendor(vendorId: String!): [VendorMapData!]
  getAllIsochronesByService(serviceId: String!): [IsochroneResult!]!
  # Get Direction from google api

  getOrderRoute(orderId: String!): RouteInfo
  getOrderWithRoute(orderId: String!): OrderWithRoute
  getRouteData(routeId: String!): RouteData!
  getAllRouteData: [RouteInfo!]!

  getRiderRanges: [RiderRange!]!
  getARiderRanges(routeId: String!): [RiderRange!]!
  getARiderRange(rangeId: String!): RiderRange!

  getIsochronesByService(vendorId: String!): IsochroneResult!
  getVendorsFromIsochroneResult: [VendorsMapData!]!
  getVendorFromIsochroneResultByServiceProdiver(
    vendorId: String!
  ): VendorsMapData!

  #  Get isochrones by rider ID and location
  getClosestIsochroneForLocation(
    riderID: String!
    location: [Float!]!
  ): IsochroneResult
}
type RiderWithMapData {
  rider: Rider
  riderService: Service
  mapData: [IsochroneResult]
}
type VendorsMapData {
  vendor: Service!
  mapData: [IsochroneResult!]!
}
type VendorMapData {
  riders: RiderWithMapData
}

extend type Mutation {
  generateIsochrone(input: IsochroneInput!): IsochroneResult!
  useRangeToGenerateIsochrone: IsochroneResult!
  inputRangeToGenerateIsochrone(input:IsochroneInput): IsochroneResult!
  createIsochroneFromInput(
    riderId: String!
    # input: IsochroneInput!
    input: NewRiderRangeInput!
    riderRangeID: String!
  ): IsochroneResult!
  updateExistingIsochroneData(
    riderId: String!
    rangeId: String!
  ): RiderRange!
  # call Direction from google api

  generateRoute(input: generateRouteInput!): RouteInfo!
  updateOrderRoute(orderId: String!, status: String!): Boolean!

  generateBookRoute(input: generateBookRouteInput!): RouteInfo!
  updateBookRoute(orderId: String!, status: String!): Boolean!

  createRiderRange(input: NewRiderRangeInput!): RiderRange!
  updateRiderRange(input: UpdateRiderRangeInput!): RiderRange!
  deleteRiderRange(id: String!): Boolean!

  deleteAllRouteData: Boolean
  manageCacheIsochrone(input: CacheManagementInput!): CacheStats!
}

type RouteInfo {
  id: ID!
  orderId: String!
  # vendorId:String!
  userId: String
  geojson: String # data from the api
  createdAt: Time!
  updatedAt: Time!
}
type RouteData {
  distance: String!
  duration: String!
}

type RiderRange {
  id: String!
  riderId: String!
  startKm: Float!
  endKm: Float!
  price: Float!
  createdAt: Time!
  updatedAt: Time!
  # rider: Rider!
}

input NewRiderRangeInput {
  startKm: Float!
  endKm: Float!
  price: Float!
}

input UpdateRiderRangeInput {
  id: ID!
  startKm: Float
  endKm: Float
  price: Float
}
type RiderProfile {
  id: String!
  name: String!
  email: String!
  dpfile: String
  availability: Boolean!
  coordinates: [Float!]
  experience: String!
  phone: String
  vehicleType: String
  rating: Float
  isOnline: Boolean!
}

# type DeliveryLocation {
#   address: String!
#   coordinates: [Float!]!
# }
#   pickupLocation: DeliveryLocation!
#   dropoffLocation: DeliveryLocation!

type RouteDetails {
  summary: String!
  totalDistance: String!
  totalDuration: String!
  polyline: String!
  steps: [RouteStep!]!
}

type RouteStep {
  instruction: String!
  distance: String!
  duration: String!
  startLocation: Coordinates!
  endLocation: Coordinates!
}

type Coordinates {
  lat: Float!
  lng: Float!
}

input generateRouteInput {
  Usercoordinates: [Float!]!
  Vendorcoordinates: [Float!]!
}
input generateBookRouteInput {
  dropoffLocation: [Float]
  pickupLocation: [Float]
}
type OrderWithRoute {
  order: Order!
  route: RouteInfo
}
