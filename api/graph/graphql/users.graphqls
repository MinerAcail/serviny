type User {
  id: String!
  name: String!
  number: String!
  numberType: String
  type: String!
  email: String


  password: String
  createdAt: Time!
  updatedAt: Time!
}

input inputUser {
  name: String!
  number: String!
  password: String!
  numberType: String
  email: String
}
input inputUpdateUser {
  name: String
  number: String
  password: String
  numberType: String
  email: String
}
extend type Query {
  getUserById(id: String!): User!
  getAllUsers: [User!]!
  getUserManager(userId:String!,entityID:String):UserManagerData
  getUserManagerData(userId:String!):UserManager
  getAllUserManagerData:[UserManager]
}
type UserManagerData{
  user:UsersInfor
  tempUser:UserManager
  book:AppointmentBooking
}
extend type Mutation {
  createUser(input: inputUser!,isService:Boolean): User!
  deleteUserById(id: String!): Boolean
  updateUser(input: inputUpdateUser): User!

  removeUserManager(userId: String!): Boolean

}
