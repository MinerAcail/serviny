type User {
  id: String!
  name: String!
  number: String!
  numberType: String
  type: String!
  email: String

  password: String
  createdAt: Time!
  updatedAt: Time!
}

input inputUser {
  name: String!
  number: String!
  password: String!
  numberType: String
  email: String
}
input inputUpdateUser {
  name: String
  number: String
  password: String
  numberType: String
  email: String
}
extend type Query {
  getUserById(id: String!): User!
  getAllUsers: [User!]!
}

extend type Mutation {
  createUser(input: inputUser!): User!
  deleteUserById(id: String!): Boolean
  updateUserById(id: String!, input: inputUpdateUser): User!
}
