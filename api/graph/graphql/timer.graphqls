type UnavailablePeriod {
  id: String!
  serviceId: String!
  day: String!
  startTime: String!
  endTime: String! # e.g., "22:00" (10 PM)
  createdAt: Time!
  updatedAt: Time!
}

extend type Query {
  getUnavailablePeriods: [UnavailablePeriod!]!
  getUnavailablePeriodsByCurrectProfile(serviceId:String!): [UnavailablePeriod!]!
  getConfirmedBookingsAsUnavailable: [AppointmentBooking!]!
  getAllUnavailablePeriods: [UnavailablePeriod!]!

  getAllAppointmentBookings: [AppointmentBookedData!]!
  getAllAppointmentBookingsByUserId(
    userId: String!
  ): [UserAppointmentBookedData!]!
  getAppointmentBookingsByUserId(userId: String!): [AppointmentBooking!]!
  getAppointmentBookingsByServiceId(serviceId: String!): [AppointmentBooking!]!
  getAppointmentBookingsByDate(date: String!): [AppointmentBooking!]!
  getConfirmedBookings(id: String!): Boolean!

  getAppointmentBooking(bookId:String):AppointmentBooking!
  getAppointmentBookingByMultiGroupId(multiGroupId:String):[AppointmentBooking!]!
  getMultiGroupedAppointmentBookingBybookId(bookId:String):[AppointmentBooking!]!
  getCargoByBookingID(bookingId:String!): BookingCargo
  getCargoByMultiGroupId(multiGroupId:String!): [BookingCargo]
}
input addBookCoordinateInput {
  bookId: String!
  deliveryAddress: String
  pickUpAddress: String
  dropoffLocation: [Float]
  pickupLocation: [Float]
  rangeMetaId: String
  ridersId: String
}
extend type Mutation {
  createUnavailablePeriod(
    input: CreateUnavailablePeriodInput!
  ): UnavailablePeriod
  deleteUnavailablePeriod(id: String!): Boolean
  getGrowthData(id: String!): GrowthData
  createMultipleBookings(
    input: [BookerInput!]!
    isMulti:Boolean
    isCargo:Boolean
    serviceId: String!
    updateTemp:Boolean
  ): [AppointmentBooking!]!
  updateCargoWithRider(riderId:String,cargoId:String):AppointmentBooking
  updateMultipleBookingsWithLocation(
    input: addBookCoordinateInput!
  ): AppointmentBooking!
  updateMultiGroupBookingsWithLocationBybookId(
    input: [addBookCoordinateInput]!
  ): [AppointmentBooking]!

  confirmBooking(id: String!): AppointmentBooking!

  deleteBooking(id: String!): Boolean
}

input CreateUnavailablePeriodInput {
  day: String!
  startTime: String!
  endTime: String!
}

input BookerInput {
  userType: String!
  startTime: String!
  endTime: String
  item: String
  notes: String
  tableSize: Int!
  userId: String!
  transportType: String
}

type AppointmentBookedData {
  book: AppointmentBooking!
  usersData: [UserData!]!
}
type AppointmentBooking {
  id: String!
  startTime: String!
  endTime: String!
  day: String!
  item: String
  notes: String
  tableSize: Int!
  serviceId: String!
  riderId: String!
  duration: String
  distance: String
  deliveryFee: String
  dropoffLocation: [Float]
  pickupLocation: [Float]
  estimatedDeliveryDate: String
  deliveryAddress: String
  pickUpAddress: String
  userId: String!
  isConfirmed: Boolean
  userType: UserType!
  multiGroupId: String
  cargoId: String
  status: String!
  createdAt: Time!
  updatedAt: Time!
}

type UserAppointmentBookedData {
  book: [AppointmentBooking!]!
  userData: UserData!
}


type BookingCargo  {
  id: String!
  serviceId: String
  userId: String
  riderId: String
  transportType: String!
  bookingId: String
  multiGroupId: String
  createdAt: Time!
  updatedAt: Time!
}