type Policy {
  id: String!
  name: String!
  description: String!
  ServiceId: String
  detailsIds: [String!]!
  isPublic: Boolean
  createdAt: Time!
  updatedAt: Time!
}

type PolicyInformation {
  policy: Policy!
  policyDetails: [PolicyDetail!]!
}

type PolicyDetail {
  id: String!
  title: String!
  content: String!
  listItems: [String!]
  policyId: String!
  createdAt: Time!
  updatedAt: Time!
}

input PolicyDetailInput {
  title: String!
  content: String!
  listItems: [String!]
}

input CreatePolicyInput {
  name: String!
  description: String!
  details: [PolicyDetailInput!]!
}

input UpdatePolicyDetailInput {
  title: String
  content: String
  listItems: [String!]
}

input UpdatePolicyInput {
  name: String
  description: String
  details: [UpdatePolicyDetailInput!]
}

type fullCard {
  card: PriceCard!
  prices: [Price!]!
  amenities: [Amenity!]!
  # serviceId: String!
}
type PriceCard {
  id: String!
  title: String!
  description: String!
  isPublic: Boolean
  ServiceId: String
  createdAt: Time!
  updatedAt: Time!
}
type Price {
  id: String!
  label: String!
  value: String!
  priceCardId: String
  createdAt: Time!
  updatedAt: Time!
}

type Amenity {
  id: String!
  text: String!
  priceCardId: String
  createdAt: Time!
  updatedAt: Time!
}

# Input Types
input PriceInput {
  label: String!
  value: String!
}

input AmenityInput {
  text: String!
}

input PriceCardInput {
  title: String!
  description: String!
  badge: String
  prices: [PriceInput!]!
  amenities: [AmenityInput!]!
}

input UpdatePriceCardInput {
  title: String
  description: String
  prices: [PriceInput!]
  amenities: [AmenityInput!]
}

type Mutation {
  createPolicy(input: CreatePolicyInput!): Policy!
  createCargoPolicy(input: CreatePolicyInput!, cargoId: String): Policy!
  addPolicyDetail(policyId: String!, input: PolicyDetailInput!): PolicyDetail!
  updatePolicy(
    policyId: String
    detailId: String
    input: UpdatePolicyInput
  ): Policy!
  deletePolicy(policyId: String!): Boolean!

  # Create a new price card
  createPriceCard(input: PriceCardInput!): fullCard!
  createCargoPriceCard(input: PriceCardInput!, cargoId: String): fullCard!

  # Update an existing price card
  updatePriceCard(input: UpdatePriceCardInput!, priceCardId: String): PriceCard!

  # Delete a price card
  deletePriceCard(priceCardId: String!): Boolean!

  # Add a price to a price card
  addPrice(priceCardId: String!, price: PriceInput!): Price!

  # Update a price within a price card
  updatePrice(cardId: String!, priceCardId: String!, input: PriceInput!): Price!

  # Remove a price from a price card
  removePrice(priceCardId: String!, id: String!): Price!

  # Add an amenity to a price card
  addAmenity(priceCardId: String!, amenity: AmenityInput!): Amenity!

  # Update an amenity within a price card
  updateAmenity(
    priceCardId: String!
    amenityId: String!
    text: String!
  ): Amenity!

  # Remove an amenity from a price card
  removeAmenity(priceCardId: String!, amenityId: String!): Amenity!

  createInvoice(input: InvoiceInput): Invoice
}
input InvoiceInput {
  cargoId: String
  notes: String
  policyId: String
  priceId: String
}
type ViewInvoice {
  policy: [PolicyInformation]
  price: [fullCard]
  serviceId: Service
  customer:UsersInfor
  cargo:BookingCargo
  booking:[AppointmentBooking]
}
type Invoice {
  id: String!
  serviceId: String!
  cargoId: String
  userId: String
  notes: String
  policyId: String
  priceId: String
  createdAt: Time!
  updatedAt: Time!
}
type Query {
  getPolicies: [Policy!]!
  getPolicyById(policyId: String!): Policy
  getPolicyInformation(ServiceID: String!): [PolicyInformation]
  getPolicyInformationByService(ServiceID: String!): [PolicyInformation]

  getPolicy(policyId: String!): PolicyInformation
  getCargoPolicy(cargoId: String!): PolicyInformation
  getInvoice(cargoId: String!): Invoice!
  getCargoPriceCardById(cardId: String): fullCard

  globalSearch(
    query: String!
    limit: Int
    offset: Int
    ServiceID: String!
  ): SearchResults!
  getpriceCardsinformation(serviceId: String): [fullCard!]!
  getpriceCardsinformationByService(serviceId: String): [fullCard!]!
  getPriceCardById(id: String!): fullCard

  getFullInvoice(cargoId:String!):ViewInvoice
}

type SearchResults {
  total: Int!
  results: [SearchResult!]!
}

type SearchResult {
  id: ID!
  title: String!
  description: String
  modelType: String!
  relationshipId: String
  additionalInfo: String
  imageurl: String
  score: Float
  createdAt: Time!
  updatedAt: Time!
}
