type PushSubscription {
  id: String!
  userID: String
  endpoint: String
  p256dh: String
  auth: String
  createdAt: Time!
  updatedAt: Time!
}

input PushSubscriptionInput {
  endpoint: String
  p256dh: String
  auth: String
}

type PushSubscriptionkey {
  privateKey: String
  publicKey: String
}
extend type Query {
  getPushSubscription(userId: String): PushSubscription
  getAllPushSubscription: [PushSubscription]
  generateVAPIDkeys: PushSubscriptionkey!
  getNotifications: NotificationData!
}

extend type Mutation {
  savePushSubscription(input: PushSubscriptionInput): PushSubscription!
  deletePushSubscription(endpoint: String): Boolean!
  sendBookingNotificationTest(
    serviceID: String!
    icon: String
    badge: String
  ): String

  createNotifications: NotificationData!
}

type RiderRequest {
  id: String!
  riderName: String!
  avatar: String
  serviceId: String!
  status: String!
  requestTime: String!
}

type DeliveryNotification {
  id: String!
  type: String!
  pickup: String!
  dropoff: String!
  completedTime: String!
  status: String!
  entityId: String
  entityType: String
  cargoId: Boolean
  multiGroupId: Boolean
  userId: String
  serviceId: String
  riderId: String
  createdAt: Time!
  updatedAt: Time!
}
type NotificationData {
  deliveryNotification: DeliveryNotification
  riderRequestNotification: DeliveryNotification
}
