type Rider {
  id: String!
  name: String!
  email: String!
  type: String!
  number: String!
  state: String
  password: String
  availability: Boolean
  dpfile: String
  idCard: [String]
  location: String
  IsochroneID: String
  coordinates: [Float]
  isTracking: Boolean!
  h3Indexes: [String]
  experience: String!
  createdAt: Time!
  updatedAt: Time!
}
input RiderInput {
  name: String!
  email: String!
  type: String!
  number: String!
  state: String
  password: String
  availability: Boolean
  dpfile: String
  idCard: [String]
  location: String
  coordinates: [Float]
  h3Indexes: [String]
  experience: String!
}
# Rider status enum
enum RiderStatus {
  ONLINE
  OFFLINE
  BUSY
  INACTIVE
}
extend type Query {
  reviewApplicate: [Rider]
  reviewAllWorks: [Rider]
  getAllWorks: [Rider]

  rider(id: ID!): Rider
  riders(status: String): [Rider!]!
  nearbyRiders(location: [Float!]!, radius: Int!): [Rider!]!

  testNearbyRiders(
    center: CoordinateInput!
    riders: [CoordinateInput!]!
  ): [NearbyRider!]!

  getjobResponse(serviceId: String!): RidersRequest
  getAllRidersResponseInfor: [riderRequestInfor!]!
  getRidersLocations: Rider!
  riderCurrentLocation(riderId: String!): [Float!]!
  getAllRidersStatusState(status: RiderStatus!): [Rider!]!
}

extend type Mutation {
  craeteRider(dpfile: Upload, idCardfiles: [Upload], input: RiderInput): Rider
  updateRiderStatus(id: String!, status: String!): Rider
  updateRider(id: String!, input: RiderInput!): Rider
  deleteRider(id: String!): Boolean

  useGetRiderTracking: Rider
  updateRiderOnlineStatus(status: RiderStatus!): Rider
  updateRiderLocation(coordinates: [Float!]!): Rider

  riderGoOnline: Rider
  riderGoOffline: Rider

  starOrStoptLocationTracking(isTracking: Boolean!): Boolean

  jobRequest(serviceId: String!, input: RidersRequestInput!): RidersRequest
  updateStateByServiceProvider(
    riderId: String!
    state: String
  ): riderRequestInfor
}
type riderRequestInfor {
  rider: Rider!
  request: RidersRequest!
}
input CoordinateInput {
  name: String!
  lat: Float!
  lng: Float!
}

type NearbyRider {
  name: String!
  lat: Float!
  lng: Float!
  h3Dist: Int!
  distance: Float!
}

# rider send request to admin
type RidersRequest {
  id: String!
  riderId: String!
  termsConditions: Boolean!
  message: String
  serviceId: String!
  state: String!
  createdAt: Time!
  updatedAt: Time!
}
input RidersRequestInput {
  termsConditions: Boolean!
  message: String
  state: String!
}

extend type Subscription {
  # Real-time subscriptions
  riderStatusChanged(riderId: String): Rider
  riderLocationUpdated(riderId: String): [Float!]!
  # nearbyRidersUpdated(location: LocationInput!, radius: Int!): [NearbyRider!]!
  # onlineRidersCount: Int!
}
